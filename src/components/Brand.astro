---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const lockup = compact ? "mark" : "full";
const label = compact ? "OMDI" : "OMDI - İşletmeler İçin Yapay Zekâ";
---

<span
  class:list={["brand-lockup", { "brand-lockup--compact": compact }]}
  role="img"
  aria-label={label}
>
  <img
    class="brand-logo brand-logo--color"
    src={`/brand/omdi-logo-${lockup}-color.png`}
    alt=""
    width={874}
    height={compact ? 242 : 339}
    decoding="async"
    aria-hidden="true"
  />
  <img
    class="brand-logo brand-logo--reverse"
    src={`/brand/omdi-logo-${lockup}-reverse.png`}
    alt=""
    width={874}
    height={compact ? 242 : 339}
    decoding="async"
    aria-hidden="true"
  />
</span>
