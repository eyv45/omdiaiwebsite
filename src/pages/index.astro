---
import {
  ArrowDown,
  ArrowRight,
  Bot,
  CircleCheckBig,
  Clock3,
  Database,
  MessageCircle,
  Send,
  Sparkles,
  Target,
  UserRoundCheck,
  Workflow,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingGrid from "../components/PricingGrid.astro";
import { benefits, faqs, journey, sectors, solutions } from "../data/content";
---

<BaseLayout
  title="OMDI — İşletmeler İçin Yapay Zekâ Çözümleri"
  description="WhatsApp müşterilerinizi 7/24 karşılayan, nitelendiren ve satış ekibinize hazır talepler bırakan yapay zekâ satış asistanı."
  bodyClass="home"
>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="shell hero__layout">
      <div class="hero__copy">
        <div class="hero__kicker">
          <span class="live-dot" aria-hidden="true"></span>
          7/24 çalışan dijital satış asistanı
        </div>
        <h1>
          İşletmeler için
          <span>Yapay Zekâ</span>
          Çözümleri
        </h1>
        <p class="hero__lead">
          Verinizi anlayan, işinize değer katan akıllı yapay zekâ çözümleri.
        </p>
        <p class="hero__value">
          WhatsApp’tan gelen müşterileri karşılar, nitelendirir ve satış
          temsilcinize görüşmeye hazır talepler bırakır.
        </p>
        <div class="hero__actions">
          <a class="button button--gold button--arrow" href="#demo-talep">
            Demo Talep Et
            <ArrowRight aria-hidden="true" />
          </a>
          <a class="button button--ghost button--arrow" href="#cozumler">
            Çözümleri Keşfet
            <ArrowDown aria-hidden="true" />
          </a>
        </div>
        <div class="hero__promise">
          <span>Zekâ.</span>
          <span>Veri.</span>
          <span>Dönüşüm.</span>
        </div>
      </div>

      <div class="signal-stage" aria-label="OMDI müşteri nitelendirme akışı">
        <div class="signal-stage__top">
          <div>
            <span class="signal-stage__status-dot"></span>
            OMDI satış akışı
          </div>
          <span>Canlı örnek</span>
        </div>

        <div class="signal-path" aria-hidden="true">
          <span class="signal-path__line"></span>
          <span class="signal-path__pulse"></span>
        </div>

        <article class="signal-card signal-card--message">
          <div class="signal-card__icon">
            <MessageCircle />
          </div>
          <div>
            <span>Yeni WhatsApp mesajı</span>
            <strong>“Saç ekimi için fiyat ve uygunluk bilgisi alabilir miyim?”</strong>
          </div>
          <small>Şimdi</small>
        </article>

        <article class="signal-card signal-card--analysis">
          <div class="signal-card__icon">
            <Sparkles />
          </div>
          <div>
            <span>OMDI anlıyor ve nitelendiriyor</span>
            <div class="signal-tags">
              <b>İşlem: Saç ekimi</b>
              <b>Plan: 1–2 ay</b>
              <b>Durum: Sıcak aday</b>
            </div>
          </div>
        </article>

        <article class="signal-card signal-card--handoff">
          <div class="signal-card__icon">
            <UserRoundCheck />
          </div>
          <div>
            <span>Satış temsilcisine hazır</span>
            <strong>İhtiyaç özeti ve görüşme talebi oluşturuldu.</strong>
          </div>
          <CircleCheckBig class="signal-card__check" />
        </article>

        <div class="signal-stage__footer">
          <span><Clock3 /> İlk yanıt beklemedi</span>
          <span><Target /> Talep nitelendirildi</span>
        </div>
      </div>
    </div>
  </section>

  <section class="problem-statement">
    <div class="shell problem-statement__inner" data-reveal>
      <p>Satış fırsatını belirleyen ilk an, müşterinin mesaj gönderdiği andır.</p>
      <h2>Müşterileriniz cevap beklerken rakibinize gitmesin.</h2>
      <a href="#nasil-calisir" aria-label="OMDI nasıl çalışır bölümüne git">
        Akışı görün
        <ArrowDown aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="section section--light journey-section" id="nasil-calisir">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="section-label">Mesajdan satış fırsatına</p>
          <h2>Her konuşma, bir sonraki doğru adıma ilerler.</h2>
        </div>
        <p>
          OMDI yalnızca cevap vermez. Müşterinin ihtiyacını netleştirir,
          talebi anlamlandırır ve ekibinize aksiyon alınabilir bir görüşme bırakır.
        </p>
      </div>

      <div class="journey-track">
        {
          journey.map((item) => (
            <article class="journey-step">
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section value-section">
    <div class="shell value-layout">
      <div class="value-layout__lead" data-reveal>
        <p class="section-label section-label--gold">İşletme sonucu</p>
        <h2>Ekibiniz daha çok konuşmaz. Daha doğru müşterilerle konuşur.</h2>
        <p>
          Tekrarlanan ilk temas işleri otomatikleşirken satış ekibiniz,
          ihtiyacı belirlenmiş ve görüşmeye hazır taleplere zaman ayırır.
        </p>
        <a class="text-link" href="/cozumler">
          Tüm çözümleri karşılaştırın
          <ArrowRight aria-hidden="true" />
        </a>
      </div>

      <div class="benefit-list">
        {
          benefits.map((benefit, index) => (
            <article class="benefit-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{benefit.title}</h3>
                <p>{benefit.copy}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section sector-preview">
    <div class="shell">
      <div class="section-heading section-heading--compact" data-reveal>
        <p class="section-label">Gerçek iş akışlarına uyarlanır</p>
        <h2>Farklı sektörler, aynı net sonuç: satışa hazır talep.</h2>
        <a class="text-link text-link--dark" href="/sektorler">
          Tüm sektör senaryoları
          <ArrowRight aria-hidden="true" />
        </a>
      </div>

      <div class="sector-ribbon" aria-label="OMDI hedef sektörleri">
        {
          sectors.map((sector, index) => (
            <a class="sector-tile" href={`/sektorler#${sector.slug}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{sector.name}</h3>
                <p>{sector.short}</p>
              </div>
              <ArrowRight aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pricing-section" id="cozumler">
    <div class="shell">
      <div class="section-heading section-heading--split section-heading--light" data-reveal>
        <div>
          <p class="section-label section-label--gold">OMDI çözümleri</p>
          <h2>İhtiyacınız kadar otomasyon. Büyüdükçe daha derin entegrasyon.</h2>
        </div>
        <p>
          Her çözüm yalnızca bir özellik listesi değil; müşteri iletişimindeki
          belirli bir darboğazı ortadan kaldıran çalışma seviyesidir.
        </p>
      </div>

      <PricingGrid />

      <div class="pricing-model" data-reveal>
        <div class="pricing-model__lead">
          <Database aria-hidden="true" />
          <div>
            <span>Şeffaf ücretlendirme modeli</span>
            <h3>Üç bileşen, tek anlaşılır kapsam.</h3>
          </div>
        </div>
        <dl>
          <div>
            <dt>01</dt>
            <dd>Tek seferlik kurulum bedeli</dd>
          </div>
          <div>
            <dt>02</dt>
            <dd>Aylık hizmet bedeli</dd>
          </div>
          <div>
            <dt>03</dt>
            <dd>Aylık müşteri görüşmesi kotası</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section about-section" id="hakkimizda">
    <div class="shell about-layout">
      <div class="about-layout__statement" data-reveal>
        <p>İşletmenizi geleceğe taşıyoruz.</p>
        <h2>Karmaşık teknolojiyi, günlük işinize değer katan net bir sisteme dönüştürüyoruz.</h2>
      </div>
      <div class="about-layout__copy">
        <p>
          OMDI, işletmelerin WhatsApp ve dijital iletişim süreçlerini yapay
          zekâ ile güçlendiren bir satış asistanı ve iş otomasyonu platformudur.
        </p>
        <p>
          Müşteri mesajlarını karşılar, soruları yanıtlar, potansiyel
          müşterileri yönlendirir ve satış sürecini hızlandırır. İşletmelerin
          daha hızlı yanıt vermesine, daha fazla talebi değerlendirmesine ve
          satış ekiplerinin zamanını verimli kullanmasına yardımcı olur.
        </p>
        <div class="about-principles">
          <span>Akıllı</span>
          <span>Hızlı</span>
          <span>Güvenilir</span>
          <span>Sonuç odaklı</span>
        </div>
        <a class="text-link text-link--dark" href="/hakkimizda">
          OMDI’yi daha yakından tanıyın
          <ArrowRight aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="section faq-section" id="sss">
    <div class="shell faq-layout">
      <div class="faq-layout__lead" data-reveal>
        <p class="section-label">Sıkça sorulanlar</p>
        <h2>Karar vermeden önce bilmeniz gerekenler.</h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details class="faq-item">
              <summary>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{faq.question}</strong>
                <i aria-hidden="true"></i>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="demo-section" id="demo-talep">
    <div class="shell demo-layout">
      <div class="demo-copy" data-reveal>
        <div class="demo-copy__icon">
          <Bot aria-hidden="true" />
        </div>
        <p class="section-label section-label--gold">Demo talebi</p>
        <h2>Müşteri akışınızı birlikte netleştirelim.</h2>
        <p>
          İşletmenizin hangi mesajları aldığını, ekibinizin nerede zaman
          kaybettiğini ve OMDI’nin hangi adımları otomatikleştirebileceğini konuşalım.
        </p>
        <ul>
          <li><Workflow /> Mevcut iletişim akışınız değerlendirilir.</li>
          <li><Target /> Uygun çözüm seviyesi netleştirilir.</li>
          <li><Clock3 /> Görüşme ihtiyacınıza odaklı ve kısa tutulur.</li>
        </ul>
      </div>

      <form class="demo-form" data-demo-form novalidate>
        <div class="demo-form__heading">
          <div>
            <span>DemoV2</span>
            <h3>Demo Talep Et</h3>
          </div>
          <p>Bu form örnek akışı gösterir; veri göndermez.</p>
        </div>

        <div class="form-grid">
          <label>
            <span>Ad soyad</span>
            <input name="fullName" autocomplete="name" required />
          </label>
          <label>
            <span>İşletme / marka <small>(isteğe bağlı)</small></span>
            <input name="company" autocomplete="organization" />
          </label>
          <label>
            <span>İş e-postası <small>(isteğe bağlı)</small></span>
            <input name="email" type="email" autocomplete="email" />
          </label>
          <label>
            <span>Telefon / WhatsApp</span>
            <input name="phone" type="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>Sektör</span>
            <select name="sector" required data-sector-select>
              <option value="">Sektör seçin</option>
              {sectors.map((sector) => <option value={sector.slug}>{sector.name}</option>)}
              <option value="diger">Diğer</option>
            </select>
          </label>
          <label>
            <span>İlgilendiğiniz çözüm</span>
            <select name="solution" required data-solution-select>
              <option value="">Çözüm seçin</option>
              {solutions.map((solution) => <option value={solution.id}>{solution.name}</option>)}
            </select>
          </label>
          <label class="form-grid__wide">
            <span>Kısa not <small>(isteğe bağlı)</small></span>
            <textarea
              name="note"
              rows="4"
              placeholder="Müşteri iletişiminde çözmek istediğiniz temel noktayı yazın."
            ></textarea>
          </label>
        </div>

        <button class="button button--gold button--full button--arrow" type="submit">
          <span>Demo Talep Et</span>
          <Send aria-hidden="true" />
        </button>
        <p class="demo-form__privacy">
          DemoV2’de bilgileriniz hiçbir sunucuya gönderilmez ve tarayıcıda saklanmaz.
        </p>
        <div class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status hidden>
          <CircleCheckBig aria-hidden="true" />
          <p></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    import { submitDemoRequest, type DemoRequest } from "../lib/demo-submission";

    const form = document.querySelector<HTMLFormElement>("[data-demo-form]");
    const status = document.querySelector<HTMLElement>("[data-form-status]");
    const solutionSelect = document.querySelector<HTMLSelectElement>("[data-solution-select]");
    const sectorSelect = document.querySelector<HTMLSelectElement>("[data-sector-select]");

    const selectedSolution = new URLSearchParams(window.location.search).get("cozum");
    if (selectedSolution && solutionSelect) {
      const optionExists = Array.from(solutionSelect.options).some(
        (option) => option.value === selectedSolution,
      );
      if (optionExists) solutionSelect.value = selectedSolution;
    }

    const selectedSector = new URLSearchParams(window.location.search).get("sektor");
    if (selectedSector && sectorSelect) {
      const optionExists = Array.from(sectorSelect.options).some(
        (option) => option.value === selectedSector,
      );
      if (optionExists) sectorSelect.value = selectedSector;
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const request: DemoRequest = {
        fullName: String(data.get("fullName") ?? ""),
        company: String(data.get("company") ?? ""),
        email: String(data.get("email") ?? ""),
        phone: String(data.get("phone") ?? ""),
        sector: String(data.get("sector") ?? ""),
        solution: String(data.get("solution") ?? ""),
        note: String(data.get("note") ?? ""),
      };

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.querySelector("span")!.textContent = "Tamamlanıyor";
      }

      const result = await submitDemoRequest(request);
      form.reset();

      if (status) {
        status.hidden = false;
        status.querySelector("p")!.textContent = result.message;
        status.focus({ preventScroll: true });
      }

      if (submitButton) {
        submitButton.disabled = false;
        submitButton.querySelector("span")!.textContent = "Demo Talep Et";
      }
    });
  </script>
</BaseLayout>
