---
import {
  ArrowLeft,
  CircleCheckBig,
  ExternalLink,
  Info,
  RotateCcw,
  Save,
  ShieldAlert,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import { solutions } from "../data/content";

const editableSolutions = solutions.filter((solution) => !("custom" in solution));
---

<BaseLayout
  title="OMDI DemoV2 — Fiyat Paneli"
  description="OMDI DemoV2 tarayıcı tabanlı fiyat düzenleme paneli."
  noindex
  hideChrome
  bodyClass="panel-page"
>
  <div class="panel-shell">
    <header class="panel-header">
      <a href="/" aria-label="OMDI ana sayfa"><Brand compact /></a>
      <div class="panel-header__title">
        <span>DemoV2 araçları</span>
        <strong>Fiyat yönetimi</strong>
      </div>
      <a
        class="button button--panel-ghost button--arrow"
        href="/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Siteyi Aç
        <ExternalLink aria-hidden="true" />
      </a>
    </header>

    <div class="panel-main">
      <a class="panel-back" href="/">
        <ArrowLeft aria-hidden="true" />
        Siteye dön
      </a>

      <div class="panel-heading">
        <div>
          <p>Yerel demo paneli</p>
          <h1>Paket fiyatlarını düzenleyin.</h1>
          <span>
            Değişiklikler yalnızca bu tarayıcıda saklanır ve aynı cihazdaki
            fiyat kartlarına yansır.
          </span>
        </div>
        <div class="panel-warning">
          <ShieldAlert aria-hidden="true" />
          <p>
            <strong>Gerçek yönetici güvenliği içermez.</strong>
            Bu rota DemoV2 sunumu için hazırlanmıştır.
          </p>
        </div>
      </div>

      <form class="price-editor" data-price-editor>
        <div class="price-editor__toolbar">
          <div class="editor-state" data-editor-state>
            <span></span>
            <p>Değişiklik yok</p>
          </div>
          <div>
            <button
              class="button button--panel-ghost button--arrow"
              type="button"
              data-reset-pricing
            >
              <RotateCcw aria-hidden="true" />
              <span>Varsayılana dön</span>
            </button>
            <button class="button button--panel-primary button--arrow" type="submit">
              <Save aria-hidden="true" />
              Değişiklikleri Kaydet
            </button>
          </div>
        </div>

        <div class="editor-grid">
          {
            editableSolutions.map((solution) => (
              <fieldset
                class:list={[
                  "editor-card",
                  { "editor-card--featured": "featured" in solution && solution.featured },
                ]}
              >
                <legend>
                  <span>{solution.label}</span>
                  <strong>{solution.name}</strong>
                  {"featured" in solution && solution.featured && (
                    <small>Öne çıkan paket</small>
                  )}
                </legend>

                <label>
                  <span>Tek seferlik kurulum bedeli</span>
                  <input
                    name={`${solution.id}.setupFee`}
                    maxlength="40"
                    value="X"
                    data-package={solution.id}
                    data-field="setupFee"
                  />
                </label>
                <label>
                  <span>Aylık hizmet bedeli</span>
                  <input
                    name={`${solution.id}.monthlyFee`}
                    maxlength="40"
                    value="X"
                    data-package={solution.id}
                    data-field="monthlyFee"
                  />
                </label>
                <label>
                  <span>Aylık görüşme kotası</span>
                  <input
                    name={`${solution.id}.monthlyConversationQuota`}
                    maxlength="40"
                    value="X"
                    data-package={solution.id}
                    data-field="monthlyConversationQuota"
                  />
                </label>
              </fieldset>
            ))
          }
        </div>

        <div class="panel-preview">
          <div class="panel-preview__head">
            <div>
              <p>Canlı önizleme</p>
              <h2>Kaydetmeden önce fiyat kartlarını kontrol edin.</h2>
            </div>
            <span><Info aria-hidden="true" /> Önizleme siz yazdıkça güncellenir.</span>
          </div>
          <div class="panel-preview__grid">
            {
              editableSolutions.map((solution) => (
                <article
                  class:list={[
                    "preview-card",
                    { "preview-card--featured": "featured" in solution && solution.featured },
                  ]}
                >
                  <p>{solution.label}</p>
                  <h3>{solution.name}</h3>
                  <div>
                    <span>Aylık hizmet</span>
                    <strong data-preview-package={solution.id} data-preview-field="monthlyFee">X</strong>
                  </div>
                  <dl>
                    <div>
                      <dt>Kurulum</dt>
                      <dd data-preview-package={solution.id} data-preview-field="setupFee">X</dd>
                    </div>
                    <div>
                      <dt>Görüşme kotası</dt>
                      <dd data-preview-package={solution.id} data-preview-field="monthlyConversationQuota">X</dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </div>

        <div class="panel-toast" role="status" aria-live="polite" data-panel-toast hidden>
          <CircleCheckBig aria-hidden="true" />
          <p></p>
        </div>
      </form>
    </div>
  </div>

  <script>
    import {
      PACKAGE_IDS,
      PRICE_FIELDS,
      createDefaultPricing,
      readPricing,
      resetPricing,
      sanitizePricingValue,
      writePricing,
      type PackageId,
      type PackagePricing,
      type PricingSnapshot,
    } from "../lib/pricing";

    const editor = document.querySelector<HTMLFormElement>("[data-price-editor]");
    const editorState = document.querySelector<HTMLElement>("[data-editor-state]");
    const resetButton = document.querySelector<HTMLButtonElement>("[data-reset-pricing]");
    const toast = document.querySelector<HTMLElement>("[data-panel-toast]");
    let savedSnapshot = readPricing();
    let resetArmed = false;
    let resetTimer = 0;

    const inputFor = (packageId: PackageId, field: keyof PackagePricing) =>
      editor?.querySelector<HTMLInputElement>(
        `[data-package="${packageId}"][data-field="${field}"]`,
      );

    const snapshotFromInputs = (): PricingSnapshot => {
      const snapshot = createDefaultPricing();
      snapshot.updatedAt = savedSnapshot.updatedAt;
      PACKAGE_IDS.forEach((packageId) => {
        PRICE_FIELDS.forEach((field) => {
          snapshot.packages[packageId][field] = sanitizePricingValue(
            inputFor(packageId, field)?.value,
          );
        });
      });
      return snapshot;
    };

    const fillInputs = (snapshot: PricingSnapshot) => {
      PACKAGE_IDS.forEach((packageId) => {
        PRICE_FIELDS.forEach((field) => {
          const input = inputFor(packageId, field);
          if (input) input.value = snapshot.packages[packageId][field];
        });
      });
      updatePreview();
      updateDirtyState();
    };

    const updatePreview = () => {
      PACKAGE_IDS.forEach((packageId) => {
        PRICE_FIELDS.forEach((field) => {
          const value = sanitizePricingValue(inputFor(packageId, field)?.value);
          document
            .querySelectorAll<HTMLElement>(
              `[data-preview-package="${packageId}"][data-preview-field="${field}"]`,
            )
            .forEach((element) => {
              element.textContent = value;
            });
        });
      });
    };

    const isDirty = () => {
      const current = snapshotFromInputs();
      return JSON.stringify(current.packages) !== JSON.stringify(savedSnapshot.packages);
    };

    const updateDirtyState = () => {
      if (!editorState) return;
      const dirty = isDirty();
      editorState.classList.toggle("is-dirty", dirty);
      editorState.querySelector("p")!.textContent = dirty
        ? "Kaydedilmemiş değişiklikler var"
        : savedSnapshot.updatedAt
          ? "Tüm değişiklikler kaydedildi"
          : "Varsayılan değerler kullanılıyor";
    };

    const showToast = (message: string) => {
      if (!toast) return;
      toast.hidden = false;
      toast.querySelector("p")!.textContent = message;
      window.setTimeout(() => {
        toast.hidden = true;
      }, 4200);
    };

    editor?.addEventListener("input", () => {
      updatePreview();
      updateDirtyState();
    });

    editor?.addEventListener("submit", (event) => {
      event.preventDefault();
      savedSnapshot = writePricing(snapshotFromInputs());
      fillInputs(savedSnapshot);
      showToast("Fiyatlar bu tarayıcıya kaydedildi ve site kartlarına yansıtıldı.");
    });

    resetButton?.addEventListener("click", () => {
      if (!resetArmed) {
        resetArmed = true;
        resetButton.querySelector("span")!.textContent = "Sıfırlamayı onayla";
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          resetArmed = false;
          resetButton.querySelector("span")!.textContent = "Varsayılana dön";
        }, 4000);
        return;
      }

      savedSnapshot = resetPricing();
      fillInputs(savedSnapshot);
      resetArmed = false;
      resetButton.querySelector("span")!.textContent = "Varsayılana dön";
      showToast("Tüm paket değerleri yeniden X olarak ayarlandı.");
    });

    window.addEventListener("beforeunload", (event) => {
      if (!isDirty()) return;
      event.preventDefault();
    });

    fillInputs(savedSnapshot);
  </script>
</BaseLayout>
