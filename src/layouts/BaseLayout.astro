---
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hideChrome?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  noindex = false,
  hideChrome = false,
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B1320" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion-ready");
      }
    </script>
  </head>
  <body class={bodyClass}>
    <!--
      THESIS: OMDI, müşterinin ilk mesajını satış ekibine ulaşan tek bir altın sinyale dönüştürür; sıradan SaaS dashboard hero düzenini reddeder.
      OWN-WORLD: Koyu lacivert saha, kontrollü altın sinyal çizgileri, açık gri kanıt yüzeyleri ve Montserrat tabanlı net hiyerarşi.
      STORY: Ziyaretçi mesajın nasıl karşılanıp nitelendirildiğini görür, sektörünü ve çözümünü bulur, demo talebine ilerler.
      FIRST VIEWPORT: Solda teklif ve iki aksiyon; sağda mesajdan satış temsilcisine uzanan üç aşamalı canlı sinyal akışı.
      FORM: İçerik odaklı asimetrik landing; imza hareketi yalnızca hero sinyal rotasında, geri kalan yüzeyler sakin ve ölçülüdür.
    -->
    <a class="skip-link" href="#ana-icerik">Ana içeriğe geç</a>
    {!hideChrome && <Header />}
    <main id="ana-icerik">
      <slot />
    </main>
    {!hideChrome && <Footer />}

    <script>
      import { syncPricingElements } from "../lib/pricing";

      const setupSite = () => {
        syncPricingElements();

        const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
        const nav = document.querySelector<HTMLElement>("[data-site-nav]");

        if (menuToggle && nav) {
          const closeMenu = () => {
            menuToggle.setAttribute("aria-expanded", "false");
            menuToggle.setAttribute("aria-label", "Menüyü aç");
            nav.classList.remove("is-open");
            document.body.classList.remove("menu-open");
          };

          menuToggle.addEventListener("click", () => {
            const open = menuToggle.getAttribute("aria-expanded") !== "true";
            menuToggle.setAttribute("aria-expanded", String(open));
            menuToggle.setAttribute("aria-label", open ? "Menüyü kapat" : "Menüyü aç");
            nav.classList.toggle("is-open", open);
            document.body.classList.toggle("menu-open", open);
          });

          nav.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth > 880) closeMenu();
          });
        }

        const revealElements = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (
          document.documentElement.classList.contains("motion-ready") &&
          "IntersectionObserver" in window
        ) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.16 },
          );
          revealElements.forEach((element) => observer.observe(element));
        } else {
          revealElements.forEach((element) => element.classList.add("is-visible"));
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupSite, { once: true });
      } else {
        setupSite();
      }
    </script>
  </body>
</html>
