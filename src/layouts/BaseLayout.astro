---
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoModal from "../components/DemoModal.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hideChrome?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  noindex = false,
  hideChrome = false,
  bodyClass = "",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/brand/omdi-logo-full-color.png", Astro.site).href;

const siteUrl = Astro.site?.href || "https://omdi.ai";

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "OMDI",
      url: siteUrl,
      logo: ogImage,
      description: "İşletmeler için WhatsApp üzerinden çalışan yapay zekâ satış asistanı.",
      areaServed: {
        "@type": "Country",
        name: "Turkey",
        identifier: "TR",
      },
      knowsLanguage: ["tr"],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}#software`,
      name: "OMDI AI Satış Asistanı",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Cloud / WhatsApp",
      description: "WhatsApp üzerinden gelen talepleri 7/24 karşılayan, nitelendiren ve satış ekibine hazır fırsatlar sunan yapay zekâ platformu.",
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "TRY",
        lowPrice: "3900",
        highPrice: "15000",
        offerCount: "3",
      },
    },
  ],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1320" />
    <meta name="google-site-verification" content="V-FmSt3PxxriBZAzYkyNVyU_FyBJyfWmigpoQLRKZ_A" />
    <!-- Google Favicon & Browser Icons (Googlebot requires 48x48 multiples) -->
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="OMDI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      )
    }
    <title>{title}</title>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion-ready");
      }
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#ana-icerik">Ana içeriğe geç</a>
    {!hideChrome && <Header />}
    <main id="ana-icerik">
      <slot />
    </main>
    {!hideChrome && <Footer />}
    {!hideChrome && <DemoModal />}

    <script>
      const setupSite = () => {
        const revealElements = document.querySelectorAll<HTMLElement>("[data-reveal]");

        if (
          document.documentElement.classList.contains("motion-ready") &&
          "IntersectionObserver" in window
        ) {
          // Aynı grup içindeki kardeşler 70ms arayla belirir.
          document.querySelectorAll<HTMLElement>("[data-reveal-group]").forEach((group) => {
            group.querySelectorAll<HTMLElement>("[data-reveal]").forEach((item, index) => {
              item.style.setProperty("--reveal-delay", `${index * 70}ms`);
            });
          });

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.15 },
          );
          revealElements.forEach((element) => observer.observe(element));
        } else {
          revealElements.forEach((element) => element.classList.add("is-visible"));
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupSite, { once: true });
      } else {
        setupSite();
      }
    </script>
  </body>
</html>
